	<string>This identifier will be used to deliver personalized ads and support free Aniimo companion tools, builds, and guides.</string>

	<!-- Google SKAdNetwork IDs for iOS AdMob attribution -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<key>io.flutter.embedded_views_preview</key>
	<true/>
